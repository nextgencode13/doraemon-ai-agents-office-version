# JARVIS Environment Configuration Template
# Copy this file to .env and fill in your values

APP_ENV=development
API_VERSION=v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Database: PostgreSQL (or fallback to SQLite for local standalone development)
# Docker default: postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis
# Local fallback default: sqlite+aiosqlite:///./jarvis.db
DATABASE_URL=sqlite+aiosqlite:///./jarvis.db

# Cache / Background Infrastructure
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration
# Supported: gemini, ollama (future)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Future Local AI (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
